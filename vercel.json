{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "build": { "env": { "VITE_USE_MOCK": "false", "VITE_API_BASE_URL": "/api/v1" } },
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "regions": ["sin1"],
      "excludeFiles": "{node_modules/**,src/**,dist/**,.mypy_cache/**,**/.pytest_cache/**,**/.ruff_cache/**,.worktrees/**,backend/.env*,backend/.venv/**,backend/.deps/**,backend/uploads/**,backend/templates/**,backend/tests/**,backend/docs/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/openapi.json", "destination": "/api/index.py" },
    { "source": "/docs", "destination": "/api/index.py" },
    { "source": "/redoc", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
