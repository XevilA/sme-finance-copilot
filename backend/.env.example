# Leave DATABASE_URL empty to run the API in stateless demo mode.
# Local Postgres via Docker: docker compose -f backend/docker-compose.yml up -d
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/sme_swarm

# Connection pooling. "null" (default) opens one connection per session and is
# safe under TestClient and serverless; "queue" pools behind a long-lived uvicorn.
# Set DB_POOL=queue on a hosted instance that stays up.
DB_POOL=null

# Applies db/*.sql at startup, because a managed Postgres add-on has no
# docker-entrypoint-initdb.d. Both files are idempotent.
#   off | schema | schema+seed
# "schema" is the default when DATABASE_URL is set. Use "schema+seed" the first
# time you deploy, to load the labelled demo rows, then drop back to "schema".
DB_BOOTSTRAP=schema

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://sme-finance-copilot.vercel.app

# --- Authentication ---------------------------------------------------------
# Secret that signs access tokens. At least 32 characters. There is no default:
# without it no token can be issued or accepted, because a known default secret
# is the same as no signature. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Token lifetime in seconds. Clamped to between 60 and 7 days, because a token
# nobody can revoke should not live for months. Default 12 hours.
AUTH_TOKEN_TTL_SECONDS=43200

# Turns on role checks. With this off nothing is verified and every caller is
# treated as permissive, which is what lets the current frontend work.
RBAC_ENFORCED=false

# Local development only: accepts an unauthenticated X-User-Email header as
# identity. NEVER enable this on a reachable instance - anyone could claim any
# role. Reported through /health so an instance using it cannot look secure.
AUTH_DEV_HEADER=false

# Optional model-assisted prioritization of existing analysis findings.
# Keep these credentials on the backend; never use VITE_ for API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- Login rate limit -------------------------------------------------------
# Held in the database, so it applies across replicas rather than per process.
# Unknown addresses are counted too, or the lockout would reveal which exist.
AUTH_MAX_ATTEMPTS=8
AUTH_ATTEMPT_WINDOW_SECONDS=900
AUTH_BLOCK_SECONDS=900

# --- External provider rate limit -------------------------------------------
# Minimum spacing between successful calls to a provider, shared by every
# worker through provider_fetch_state. Failures back off by doubling from the
# base up to the ceiling, and a Retry-After from the provider wins when longer.
PROVIDER_MIN_INTERVAL_SECONDS=300
PROVIDER_BACKOFF_BASE_SECONDS=60
PROVIDER_BACKOFF_CEILING_SECONDS=3600
